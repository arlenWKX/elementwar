# ElementWar Backend 环境变量
# 复制为 .env 并按需修改（大多数情况下无需修改，默认值即可工作）

# 运行环境
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_LOG_LEVEL=INFO

# JWT 密钥（生产环境必须修改为 ≥32 字符随机字符串）
JWT_SECRET=change-me-in-production-please-use-a-long-random-string

# CORS（* 允许所有来源；生产环境建议设为前端域名）
CORS_ORIGINS=*

# 以下配置默认使用绝对路径，通常无需修改：
# DATABASE_URL      → backend/data/game.db
# CHEMKIT_DATA_DIR  → backend/chemkit/data
# GAME_CONFIG_PATH  → backend/app/data/game_config.json
# MATERIALS_PATH    → backend/app/data/materials.json
